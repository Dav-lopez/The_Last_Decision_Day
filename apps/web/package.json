{
  "name": "the-last-decision-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:movement": "node --test tests/3d-movement.test.mjs tests/3d-controls.test.mjs tests/camera-follow.test.mjs",
    "test:appearance": "node --test tests/avatar-appearance.test.mjs",
    "test:human": "node --test tests/human-motion.test.mjs tests/human-asset-bounds.test.mjs",
    "test:character": "node --test tests/rigged-character.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3"
  }
}
